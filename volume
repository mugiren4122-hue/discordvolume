<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discord Bot 音量コントロール</title>
    <style>
        body {
            background-color: #1e1e2e;
            color: #cdd6f4;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            background-color: #313244;
            padding: 30px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
            width: 320px;
        }
        h2 { margin-bottom: 20px; font-size: 22px; }
        .input-group {
            margin-bottom: 15px;
            text-align: left;
        }
        label { font-size: 12px; color: #a6adc8; display: block; margin-bottom: 4px; }
        input[type=text] {
            width: 100%;
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #45475a;
            background-color: #1e1e2e;
            color: #cdd6f4;
            box-sizing: border-box;
        }
        input[type=range] {
            width: 100%;
            margin: 20px 0 10px 0;
            accent-color: #89b4fa;
        }
        .vol-display {
            font-size: 28px;
            font-weight: bold;
            color: #89b4fa;
            margin-bottom: 20px;
        }
        button {
            background-color: #89b4fa;
            color: #11111b;
            border: none;
            padding: 12px 24px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            transition: background 0.2s;
        }
        button:hover { background-color: #b4befe; }
        #status { margin-top: 15px; font-size: 14px; min-height: 20px; }
    </style>
</head>
<body>
    <div class="card">
        <h2>🔊 音量コントロール</h2>
        
        <div class="input-group">
            <label for="serverUrl">Bot接続先アドレス (ngrok等のURL)</label>
            <input type="text" id="serverUrl" placeholder="https://xxxx.ngrok-free.app">
        </div>

        <div class="input-group">
            <label for="guildId">サーバーID</label>
            <input type="text" id="guildId" placeholder="DiscordのサーバーID">
        </div>

        <input type="range" id="volumeRange" min="0" max="100" value="50" oninput="document.getElementById('volVal').innerText = this.value">
        <div class="vol-display"><span id="volVal">50</span>%</div>

        <button onclick="sendVolume()">決定</button>
        <div id="status"></div>
    </div>

    <script>
        // ページ読み込み時に保存されたURLとGuild IDを復元
        window.onload = () => {
            if(localStorage.getItem('bot_url')) document.getElementById('serverUrl').value = localStorage.getItem('bot_url');
            if(localStorage.getItem('guild_id')) document.getElementById('guildId').value = localStorage.getItem('guild_id');
        };

        async function sendVolume() {
            let baseUrl = document.getElementById('serverUrl').value.trim();
            const guildId = document.getElementById('guildId').value.trim();
            const volume = parseInt(document.getElementById('volumeRange').value);
            const status = document.getElementById('status');

            if (!baseUrl || !guildId) {
                status.style.color = '#f38ba8';
                status.innerText = '接続先URLとサーバーIDを入力してください';
                return;
            }

            // URLの末尾のスラッシュを削除
            baseUrl = baseUrl.replace(/\/$/, "");
            
            // localStorageに保存
            localStorage.setItem('bot_url', baseUrl);
            localStorage.setItem('guild_id', guildId);

            status.style.color = '#f9e2af';
            status.innerText = '送信中...';

            try {
                const res = await fetch(`${baseUrl}/api/volume`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ guild_id: guildId, volume: volume })
                });
                const data = await res.json();
                if (res.ok) {
                    status.style.color = '#a6e3a1';
                    status.innerText = data.message;
                } else {
                    status.style.color = '#f38ba8';
                    status.innerText = data.message || 'エラーが発生しました';
                }
            } catch (e) {
                status.style.color = '#f38ba8';
                status.innerText = 'Botへの通信に失敗しました';
            }
        }
    </script>
</body>
</html>
